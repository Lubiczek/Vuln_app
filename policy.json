{
  "_comment": "Simplified teaching tenant for fma_sim. Edit, save, re-run: the simulator re-reads this file on every request.",
  "security_defaults": false,
  "security_defaults_mfa_resources": ["https://management.azure.com", "https://management.core.windows.net"],
  "lockout_threshold": 10,
  "lockout_seconds": 60,
  "revoked_sessions": [],
  "users": [
    {"upn": "lab-s1-nomfa@lab.example",    "password": "Lab-S1-Pass!2026", "groups": ["LAB-AllTestUsers"], "mfa_registered": false},
    {"upn": "lab-s2-unreg@lab.example",    "password": "Lab-S2-Pass!2026", "groups": ["LAB-AllTestUsers", "LAB-S2"], "mfa_registered": false},
    {"upn": "lab-s3-o365@lab.example",     "password": "Lab-S3-Pass!2026", "groups": ["LAB-AllTestUsers", "LAB-S3"], "mfa_registered": true},
    {"upn": "lab-s4-platform@lab.example", "password": "Lab-S4-Pass!2026", "groups": ["LAB-AllTestUsers", "LAB-S4"], "mfa_registered": true},
    {"upn": "lab-s5-browser@lab.example",  "password": "Lab-S5-Pass!2026", "groups": ["LAB-AllTestUsers", "LAB-S5"], "mfa_registered": true},
    {"upn": "lab-s6-covered@lab.example",  "password": "Lab-S6a-Pass!2026", "groups": ["LAB-AllTestUsers", "LAB-S6-Scope"], "mfa_registered": true},
    {"upn": "lab-s6-excluded@lab.example", "password": "Lab-S6b-Pass!2026", "groups": ["LAB-AllTestUsers", "LAB-S6-Scope", "LAB-S6-Exclusions"], "mfa_registered": true},
    {"upn": "lab-s7-reportonly@lab.example","password": "Lab-S7-Pass!2026", "groups": ["LAB-AllTestUsers", "LAB-S7"], "mfa_registered": true},
    {"upn": "lab-hardened@lab.example",    "password": "Lab-H-Pass!2026",  "groups": ["LAB-AllTestUsers", "LAB-Hardened"], "mfa_registered": true}
  ],
  "policies": [
    {"name": "LAB-S2 Require MFA all resources", "state": "on", "include_groups": ["LAB-S2"], "include_resources": ["all"], "grant": "mfa"},
    {"name": "LAB-S3 Require MFA for Office 365 only", "state": "on", "include_groups": ["LAB-S3"],
     "include_resources": ["https://outlook.office365.com", "https://outlook-sdf.office.com", "https://officeapps.live.com", "https://onenote.com", "https://api.spaces.skype.com", "https://api.skypeforbusiness.com", "https://webshell.suite.office.com", "https://manage.office.com", "https://api.yammer.com"], "grant": "mfa"},
    {"name": "LAB-S4 Require MFA on known platforms", "state": "on", "include_groups": ["LAB-S4"], "include_resources": ["all"],
     "include_platforms": ["android", "iOS", "windows", "macOS", "linux"], "grant": "mfa"},
    {"name": "LAB-S5 Require MFA for browsers", "state": "on", "include_groups": ["LAB-S5"], "include_resources": ["all"],
     "client_app_types": ["browser"], "grant": "mfa"},
    {"name": "LAB-S6 Require MFA all resources", "state": "on", "include_groups": ["LAB-S6-Scope"], "exclude_groups": ["LAB-S6-Exclusions"], "include_resources": ["all"], "grant": "mfa"},
    {"name": "LAB-S7 Require MFA all resources", "state": "reportOnly", "include_groups": ["LAB-S7"], "include_resources": ["all"], "grant": "mfa"},
    {"name": "LAB-H1 Require MFA all resources", "state": "on", "include_groups": ["LAB-Hardened"], "include_resources": ["all"], "grant": "mfa"},
    {"name": "LAB-H2 Block unknown platforms", "state": "on", "include_groups": ["LAB-Hardened"], "include_resources": ["all"],
     "include_platforms": ["all"], "exclude_platforms": ["android", "iOS", "windows", "macOS", "linux"], "grant": "block"}
  ]
}
